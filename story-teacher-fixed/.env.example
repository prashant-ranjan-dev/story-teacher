# --- Required for AI features -------------------------------------------------
# Get a key at https://aistudio.google.com/apikey. Without it the app still runs using offline stories.
GEMINI_API_KEY=""

# --- Optional: models (verify these are available to your key) -----------------
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_IMAGE_MODEL="imagen-3.0-generate-002"
# Time budgets in milliseconds
GEMINI_TEXT_TIMEOUT_MS=25000
GEMINI_IMAGE_TIMEOUT_MS=10000

# --- Optional: Supabase (cover-image cache) ------------------------------------
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Server-only secret. Never prefix with VITE_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Server ---------------------------------------------------------------------
PORT=3000
# Max AI requests per IP per minute
AI_RATE_LIMIT_PER_MIN=30
# Set to the number of reverse proxies in front of the app (e.g. 1) so rate limiting sees real client IPs
TRUST_PROXY=""

# APP_URL: where this app is hosted (used by AI Studio / deployment tooling).
APP_URL="MY_APP_URL"
